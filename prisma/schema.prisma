// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Trading section models.
// Prefixed conceptually as "trading" domain data; kept in the same database
// as future sections (Etsy, Life) since this is a single-user dashboard, but
// nothing outside /app/dashboard/trading and /lib/trading should reference
// these models directly.
// ---------------------------------------------------------------------------

enum TradeDirection {
  LONG
  SHORT
}

enum AssetClass {
  FUTURES_METALS
  CRYPTO
}

enum TradingSession {
  ASIA
  LONDON
  NEW_YORK
  OTHER
}

enum TradeSource {
  MANUAL
  CSV_IMPORT
}

model Trade {
  id              String         @id @default(cuid())
  symbol          String
  direction       TradeDirection
  assetClass      AssetClass
  entryPrice      Decimal?
  exitPrice       Decimal?
  positionSize    Decimal?
  stopLoss        Decimal?
  riskDollars     Decimal?
  entryTime       DateTime
  exitTime        DateTime
  pnl             Decimal
  rMultiple       Decimal?
  durationMinutes Int
  session         TradingSession
  source          TradeSource    @default(MANUAL)
  externalId      String?        @unique // broker fill-id pair, for CSV re-import de-dupe
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tags        TradeTag[]
  psychology  PsychologyEntry?
  screenshots TradeScreenshot[]

  @@index([entryTime])
  @@index([session])
  @@index([assetClass])
}

model TradeScreenshot {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

model Tag {
  id       String     @id @default(cuid())
  name     String     @unique
  category String?
  trades   TradeTag[]
}

model TradeTag {
  tradeId String
  tagId   String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
}

model PsychologyEntry {
  id          String  @id @default(cuid())
  tradeId     String  @unique
  trade       Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  preEmotion  String?
  postEmotion String?
  notes       String?
}

// A setup that was seen forming (futures/metals only) but not actually
// traded — deliberately separate from Trade, since there's no entry/exit
// price or P&L, just what was seen and why it wasn't taken.
model MissedSetup {
  id               String         @id @default(cuid())
  symbol           String
  direction        TradeDirection
  setupDescription String
  reasonSkipped    String
  notes            String?
  seenAt           DateTime
  createdAt        DateTime       @default(now())

  screenshots MissedSetupScreenshot[]

  @@index([seenAt])
}

model MissedSetupScreenshot {
  id            String      @id @default(cuid())
  missedSetupId String
  missedSetup   MissedSetup @relation(fields: [missedSetupId], references: [id], onDelete: Cascade)
  url           String
  createdAt     DateTime    @default(now())
}

model PlaybookRule {
  id          String   @id @default(cuid())
  title       String
  content     String
  setupGrade  String
  order       Int      @default(0)
  strategyKey String?  @unique // stable machine key (e.g. "golden-pocket") matched against TradingView webhook/CSV payloads — nullable since existing rules predate this, assigned one at a time as each strategy is wired up
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occurrences SetupOccurrence[]
}

enum SetupOccurrenceStatus {
  PENDING // setup fired, exit not yet resolved
  WIN
  LOSS
  BREAKEVEN
}

enum SetupOccurrenceSource {
  WEBHOOK // live, pushed from a TradingView alert
  CSV_IMPORT // backfilled from a Strategy Tester "List of Trades" export
}

// A detected occurrence of a playbook strategy's setup in the real NQ market,
// sourced from a TradingView Pine strategy (backtest CSV or live webhook) —
// independent of whether the user actually traded it. See Trade for the
// user's own trade log; this is market behavior, not personal trade history.
model SetupOccurrence {
  id              String                @id @default(cuid())
  playbookRuleId  String
  playbookRule    PlaybookRule          @relation(fields: [playbookRuleId], references: [id], onDelete: Restrict)
  symbol          String                @default("NQ")
  direction       TradeDirection
  status          SetupOccurrenceStatus @default(PENDING)
  entryPrice      Decimal
  exitPrice       Decimal?
  stopPrice       Decimal?
  targetPrice     Decimal?
  contracts       Int                   @default(1)
  pnlPoints       Decimal?
  pnlDollars      Decimal?
  entryTime       DateTime
  exitTime        DateTime?
  source          SetupOccurrenceSource
  externalId      String?               @unique
  entryRawPayload Json?
  exitRawPayload  Json?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([playbookRuleId, entryTime])
  @@index([entryTime])
  @@index([status])
}

enum MarketBreakdownPostType {
  NY_OPEN
  FIRST_HOUR
  MIDDAY
  DAILY_RECAP
}

// A session-level NQ bias/levels snapshot, computed from the user's own
// TradingView Pine indicator (not scraped from any third-party Discord) and
// narrated via Gemini in a similar style to the reference format the user
// showed. Independent of Trade/SetupOccurrence — this is broad market
// context, not personal trade history or a specific setup's occurrences.
model MarketBreakdownPost {
  id                  String                  @id @default(cuid())
  symbol              String                  @default("NQ")
  postType            MarketBreakdownPostType
  tradingDate         DateTime // NY calendar day this post belongs to, UTC-midnight date label (same convention as PremarketChecklist.date)
  postedAt            DateTime // real alert-fire time
  price               Decimal
  vix                 Decimal?
  sessionVolumePct    Decimal? // session volume as % of 30-day average at this point in the day
  ibHigh              Decimal?
  ibLow               Decimal?
  keyLevelsData       Json // [{name, price, distanceFromPrice, tapped}] — VWAP stack, PDH/PDL, PWH/PWL, PMH/PML, opens, PM high/low
  structureData       Json? // phase 2: {daily:{bias,label}, h4:{...}, h1:{...}, m5:{...}}
  valueAreaData       Json? // phase 3: {poc, vah, val} for prior session
  historicalStatsData Json? // phase 4: base-rate stats, nullable unless/until a historical data source exists
  narrative           Json? // AI-generated prose sections, cached at ingest time: {alignment, bias, priorValue, gameplan, lineInSand, tradeLocation, whatNotToDo}
  rawPayload          Json // full webhook body, durability log
  externalId          String                  @unique
  createdAt           DateTime                @default(now())

  @@index([tradingDate, postType])
}

model PremarketChecklist {
  id        String   @id @default(cuid())
  date      DateTime @unique
  bias      String
  keyLevels String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskSettings {
  id              String   @id @default(cuid())
  accountSize     Decimal
  dailyLossLimit  Decimal
  maxRiskPerTrade Decimal
  updatedAt       DateTime @updatedAt
}

model TradingRulesNote {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
}

model SignalLogEntry {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  rawText   String
  symbol    String?
  source    String   @default("manual")
}

// ---------------------------------------------------------------------------
// Life section models (income/expenses). Kept entirely separate from the
// trading models above — no shared tables, no reads of Trade P&L. Only
// lib/core/sections.ts is touched to register this section.
// ---------------------------------------------------------------------------

enum LifeEntryType {
  PERSONAL
  BUSINESS
}

model Expense {
  id        String        @id @default(cuid())
  amount    Decimal
  category  String
  type      LifeEntryType
  note      String?
  date      DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
  @@index([type])
}

model IncomeEntry {
  id        String        @id @default(cuid())
  amount    Decimal
  source    String
  type      LifeEntryType
  note      String?
  date      DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Etsy section models (seller workspace for AI-generated wall-art posters).
// Stage 1: full domain model defined now, only Settings gets real UI this
// stage — everything else is schema-only until its own build stage. Kept
// entirely separate from Trading/Life — only lib/core/sections.ts is touched
// to register this section.
// ---------------------------------------------------------------------------

enum EtsyProductStatus {
  WORKING
  REVIEW
  READY
  LISTED
  ARCHIVED
}

enum EtsyArtworkRole {
  ORIGINAL
  MOCKUP
  SIZE_GUIDE
}

enum EtsyAnalyticsSource {
  MANUAL
  SYNCED
}

model EtsySettings {
  id                   String   @id @default(cuid())
  currency             String   @default("GBP")
  fulfillmentProvider  String?
  skuDigits            Int      @default(3)
  skuCounter           Int      @default(0) // last allocated sequential SKU number; monotonic, survives product deletion so a SKU is never silently reused
  artworkRatios        String[] @default(["2:3", "5:6"])
  updatedAt            DateTime @updatedAt
}

model EtsyProduct {
  id             String                @id @default(cuid())
  sku            String                @unique
  title          String
  status         EtsyProductStatus     @default(WORKING)
  etsyListingId  String?
  etsyListingUrl String?
  listedAt       DateTime?
  promptId       String?               @unique
  prompt         EtsyPrompt?           @relation(fields: [promptId], references: [id])
  listingDraft   EtsyListingDraft?
  artwork        EtsyArtworkAsset[]
  analytics      EtsyAnalyticsRecord[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
}

model EtsyPromptWorkspace {
  id                String       @id @default(cuid())
  collectionRequest String
  requestedCount    Int          @default(1) // how many prompts were originally asked for — lets "retry missing only" know the gap
  researchDate      DateTime?
  researchSummary   String?
  prompts           EtsyPrompt[]
  createdAt         DateTime     @default(now())
}

model EtsyPrompt {
  id              String              @id @default(cuid())
  workspaceId     String
  workspace       EtsyPromptWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promptText      String
  aspectRatio     String
  sourceLinks     Json?
  evidenceSignals Json?
  confidence      String?
  order           Int                 @default(0)
  product         EtsyProduct?
  createdAt       DateTime            @default(now())

  @@index([workspaceId])
}

model EtsyListingDraft {
  id                 String      @id @default(cuid())
  productId          String      @unique
  product            EtsyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  title              String
  description        String
  tags               String[]
  suggestedCategory  String?
  suggestedMaterials String?
  altText            String?
  aiDisclosure       String?
  pricingNotes       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model EtsyArtworkAsset {
  id        String          @id @default(cuid())
  productId String
  product   EtsyProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String
  role      EtsyArtworkRole
  url       String
  order     Int             @default(0)
  isPrimary Boolean         @default(false)
  width     Int?
  height    Int?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([sku])
}

model EtsyKeyword {
  id         String   @id @default(cuid())
  term       String   @unique
  niche      String?
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model EtsyBundle {
  id             String              @id @default(cuid())
  title          String
  description    String
  suggestedPrice Decimal?
  products       EtsyBundleProduct[]
  createdAt      DateTime            @default(now())
}

model EtsyBundleProduct {
  bundleId  String
  bundle    EtsyBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String

  @@id([bundleId, productId])
}

model EtsyAnalyticsRecord {
  id         String              @id @default(cuid())
  productId  String?
  product    EtsyProduct?        @relation(fields: [productId], references: [id])
  date       DateTime
  views      Int                 @default(0)
  favourites Int                 @default(0)
  orders     Int                 @default(0)
  revenue    Decimal             @default(0)
  source     EtsyAnalyticsSource @default(MANUAL)
  createdAt  DateTime            @default(now())

  @@index([date])
  @@index([productId])
}

model EtsyOpportunityScan {
  id          String   @id @default(cuid())
  topic       String
  resultsJson Json
  createdAt   DateTime @default(now())
}

model EtsyConnection {
  id               String    @id @default(cuid())
  shopId           String
  scope            String
  accessTokenEnc   String
  refreshTokenEnc  String
  expiresAt        DateTime
  connectedAt      DateTime  @default(now())
  lastSyncedAt     DateTime?
}
